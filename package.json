{
  "name": "aletheia",
  "version": "1.0.0",
  "description": "Aletheia: unconceal security flaws in web service source code",
  "type": "module",
  "bin": {
    "aletheia": "./bin/aletheia.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "start": "node bin/aletheia.js",
    "scan": "node bin/aletheia.js scan",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js"
  },
  "keywords": [
    "aletheia",
    "sast",
    "security",
    "cli",
    "web",
    "vulnerability",
    "static-analysis"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "commander": "^14.0.1"
  }
}
